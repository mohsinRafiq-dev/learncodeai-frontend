# Backend API URL
# Development: http://localhost:5000/api
# Production: https://your-production-domain.com/api
VITE_API_URL=http://localhost:5000/api

# EmailJS — contact-form email notification (https://www.emailjs.com/)
# Grab these from your EmailJS dashboard:
#   service_xxx  → Email Services → your service
#   template_xxx → Email Templates → your template
#   public key   → Account → API Keys → Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
